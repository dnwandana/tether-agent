{
  "name": "tether-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "marked": "15.0.12",
    "vue": "3.5.17",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.10"
  }
}
