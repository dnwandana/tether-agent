{
  "name": "tether-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.18.0 || >=26.3.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "marked": "15.0.12",
    "reka-ui": "2.11.0",
    "shiki": "4.6.0",
    "vue": "3.5.45",
    "vue-router": "4.5.1",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@types/node": "22.15.21",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.5.1",
    "jsdom": "29.1.1",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "overrides": {
    "js-beautify": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
